<!DOCTYPE html>
<html>
<head>
  <title>Blog App</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>

<div class="container">
  <h1>My Blog</h1>

  <a href="/create" class="btn">Create New Post</a>

  <% if(posts.length === 0){ %>
    <p>No posts yet.</p>
  <% } %>

  <% posts.forEach(post => { %>
    <div class="card">
      <h2><%= post.title %></h2>
      <p><%= post.content %></p>

      <div class="actions">
        <a href="/edit/<%= post.id %>" class="edit">Edit</a>

        <form action="/posts/<%= post.id %>?_method=DELETE" method="POST">
          <button type="submit" class="delete">Delete</button>
        </form>
      </div>
    </div>
  <% }) %>
</div>

</body>
</html>